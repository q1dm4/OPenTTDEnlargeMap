+uint32_t _map_expansion_width = 0;
+uint32_t _map_expansion_height = 0;
+
+uint32_t RemapExpansionTile(uint32_t tile)
+{
+    if (_map_expansion_width == 0 || tile == UINT32_MAX) return tile;
+    if (tile >= Map::Size()) SlErrorCorruptFmt("Expansion encountered out-of-range tile {}", tile);
+    return (tile / Map::SizeX()) * _map_expansion_width + tile % Map::SizeX();
+}
+
+bool ExportExpandedMap(uint32_t width, uint32_t height, const std::string &filename, std::string &error)
+{
+    if (_networking || _game_mode != GameMode::Normal) { error = "Expansion requires a single-player game."; return false; }
+    if (!ValidateMapSize(width, height) || width < Map::SizeX() || height < Map::SizeY() || (width == Map::SizeX() && height == Map::SizeY())) {
+        error = "Use valid larger map dimensions; shrinking is not supported."; return false;
+    }
+    if (Game::GetInstance() != nullptr) { error = "GameScript state may contain opaque tile numbers; expansion is not supported for this save."; return false; }
+    for (const Company *company : Company::Iterate()) if (company->is_ai) {
+        error = "AI state may contain opaque tile numbers; expansion is not supported for this save."; return false;
+    }
+    if (FioCheckFileExists(filename, Subdirectory::Save)) { error = "Output already exists. Choose a new save name; existing files are never overwritten."; return false; }
+    for (const Vehicle *v : Vehicle::Iterate()) if (v->type == VehicleType::Disaster) { error = "Active disaster state uses overloaded tile references; wait until the disaster ends before expanding."; return false; }
+    WaitTillSaved();
+    _map_expansion_width = width;
+    _map_expansion_height = height;
+    auto restore = scope_guard([] { _map_expansion_width = 0; _map_expansion_height = 0; });
+    const auto result = SaveOrLoad(filename, SaveLoadOperation::Save, DetailedFileType::GameFile, Subdirectory::Save, false);
+    if (result != SaveLoadResult::Ok) { error = "Expanded save export failed."; return false; }
+    return true;
+}
+
+void WriteExpandedMapTiles()
+{
+    const uint32_t width = _map_expansion_width, height = _map_expansion_height;
+    const uint32_t size = width * height;
+    std::vector<Tile> tiles(size);
+    std::vector<TileExtended> extended(size);
+    for (uint32_t y = 0; y < height; ++y) for (uint32_t x = 0; x < width; ++x) {
+        const uint32_t index = y * width + x;
+        Tile &tile = tiles[index];
+        if (x < Map::SizeX() && y < Map::SizeY()) {
+            const TileIndex old{y * Map::SizeX() + x};
+            tile = _m[old]; extended[index] = _me[old];
+            if (!IsTileType(old, TileType::Void) || (x != Map::MaxX() && y != Map::MaxY())) continue;
+            if (_settings_game.construction.freeform_edges && (x == 0 || y == 0)) continue;
+            // The old east/south void border becomes a shoreline at height zero.
+            tile = {}; extended[index] = {};
+            tile.m1 = OWNER_NONE.base(); tile.m5 = 3;
+            continue;
+        }
+        tile.height = 1; tile.m1 = OWNER_NONE.base(); tile.m5 = 3;
+        if (x == width - 1 || y == height - 1 || (_settings_game.construction.freeform_edges && (x == 0 || y == 0))) {
+            tile = {}; tile.type = to_underlying(TileType::Void) << 4;
+        }
+    }
+    static_assert(std::endian::native == std::endian::little);
+    SlSetLength(size * 12);
+    auto *dumper = MemoryDumper::GetCurrent();
+    dumper->CopyBytes(reinterpret_cast<uint8_t *>(tiles.data()), size * sizeof(Tile));
+    dumper->CopyBytes(reinterpret_cast<uint8_t *>(extended.data()), size * sizeof(TileExtended));
+}
+
+std::string GetMapExpansionReport()
+{
+    uint64_t cargo = 0;
+    for (const Vehicle *v : Vehicle::Iterate()) if (v->type <= VehicleType::Aircraft) cargo += v->cargo.StoredCount();
+    uint64_t hash = 1469598103934665603ULL, packet_cargo = 0;
+    auto mix = [&](uint64_t value) { hash ^= value; hash *= 1099511628211ULL; };
+    auto tile = [&](TileIndex t) { if (t == INVALID_TILE) { mix(UINT32_MAX); mix(UINT32_MAX); } else { mix(TileX(t)); mix(TileY(t)); } };
+    for (const Town *v : Town::Iterate()) { mix(1); mix(v->index.base()); tile(v->xy); }
+    for (const BaseStation *v : BaseStation::Iterate()) { mix(2); mix(v->index.base()); tile(v->xy); }
+    for (const Industry *v : Industry::Iterate()) { mix(3); mix(v->index.base()); tile(v->location.tile); }
+    for (const Depot *v : Depot::Iterate()) { mix(4); mix(v->index.base()); tile(v->xy); }
+    for (const Tunnel *v : Tunnel::Iterate()) { mix(5); mix(v->index.base()); tile(v->tile_n); tile(v->tile_s); }
+    for (const Vehicle *v : Vehicle::Iterate()) { mix(6); mix(v->index.base()); tile(v->tile); mix(v->x_pos); mix(v->y_pos); if (v->type <= VehicleType::Aircraft) tile(v->dest_tile); }
+    for (const CargoPacket *p : CargoPacket::Iterate()) packet_cargo += p->Count();
+    return fmt::format("Map {}x{}; companies {}; towns {}; industries {}; stations {}; vehicles {}; order lists {}; cargo packets {}; stored cargo {}; total packet cargo {}; coordinate fingerprint {:016x}",
+        Map::SizeX(), Map::SizeY(), Company::GetNumItems(), Town::GetNumItems(), Industry::GetNumItems(), BaseStation::GetNumItems(),
+        Vehicle::GetNumItems(), OrderList::GetNumItems(), CargoPacket::GetNumItems(), cargo, packet_cargo, hash);
+}
