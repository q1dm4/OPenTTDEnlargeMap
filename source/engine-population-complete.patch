new file mode 100644
--- /dev/null
+++ b/src/map_population.cpp
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "stdafx.h"
+#include "map_population.h"
+#include "map_func.h"
+#include "tile_map.h"
+#include "town.h"
+#include "industry.h"
+#include "company_base.h"
+#include "company_func.h"
+#include "network/network.h"
+#include "game/game.hpp"
+#include "core/random_func.hpp"
+#include "core/backup_type.hpp"
+#include "genworld.h"
+#include "fileio_func.h"
+#include "sl/saveload.h"
+#include "scope.h"
+#include "safeguards.h"
+
+bool _populating_expansion = false;
+static uint _population_old_width, _population_old_height;
+
+bool IsExpansionPopulationTile(TileIndex tile)
+{
+    if (!_populating_expansion) return true;
+    if (tile >= Map::Size() || !IsValidTile(tile)) return false;
+    const uint x = TileX(tile), y = TileY(tile);
+    // Leave an untouched strip beside the old map and the external boundary.
+    return x >= 16 && y >= 16 && x + 16 < Map::MaxX() && y + 16 < Map::MaxY() &&
+        (x >= _population_old_width + 16 || y >= _population_old_height + 16);
+}
+
+TileIndex RandomExpansionPopulationTile()
+{
+    for (uint tries = 0; tries < 10000; ++tries) {
+        TileIndex tile = RandomTile();
+        if (IsExpansionPopulationTile(tile)) return tile;
+    }
+    return INVALID_TILE;
+}
+
+static uint64_t OriginalTileChecksum(uint w, uint h)
+{
+    uint64_t hash = 14695981039346656037ULL;
+    auto add = [&](const auto &value) {
+        const uint8_t *p = reinterpret_cast<const uint8_t *>(&value);
+        for (size_t i = 0; i < sizeof(value); ++i) hash = (hash ^ p[i]) * 1099511628211ULL;
+    };
+    for (uint y = 0; y < h; ++y) for (uint x = 0; x < w; ++x) {
+        TileIndex t = TileXY(x, y); add(_m[t]); add(_me[t]);
+    }
+    return hash;
+}
+
+bool PopulateExpandedMap(uint old_width, uint old_height, uint towns, uint industries, const std::string &filename, std::string &report)
+{
+    if (_networking || _game_mode != GameMode::Normal || _populating_expansion) { report = "Requires a single-player game."; return false; }
+    if (old_width < 64 || old_height < 64 || old_width > Map::SizeX() || old_height > Map::SizeY() ||
+        (old_width == Map::SizeX() && old_height == Map::SizeY()) || towns > 2000 || industries > 10000 || towns + industries == 0) {
+        report = "Invalid original dimensions or counts (maximum 2000 towns, 10000 industries)."; return false;
+    }
+    if (Game::GetInstance() != nullptr) { report = "GameScript saves are not supported."; return false; }
+    for (const Company *c : Company::Iterate()) if (c->is_ai) { report = "AI saves are not supported."; return false; }
+    if (FioCheckFileExists(filename, Subdirectory::Save)) { report = "Output exists; choose a new save name."; return false; }
+    WaitTillSaved();
+    const uint64_t before = OriginalTileChecksum(old_width, old_height);
+    _population_old_width = old_width; _population_old_height = old_height;
+    uint made_towns, made_industries;
+    {
+        AutoRestoreBackup active(_populating_expansion, true);
+        AutoRestoreBackup generating(_generating_world, true);
+        AutoRestoreBackup company(_current_company, OWNER_NONE);
+        made_towns = GenerateExpansionTowns(towns);
+        made_industries = GenerateExpansionIndustries(industries);
+    }
+    if (before != OriginalTileChecksum(old_width, old_height)) {
+        report = "Original-region tile verification failed. No populated save was written. Reload your input save."; return false;
+    }
+    const auto result = SaveOrLoad(filename, SaveLoadOperation::Save, DetailedFileType::GameFile, Subdirectory::Save, false);
+    report = fmt::format("Created {}/{} towns and {}/{} industries. Original {}x{} tiles unchanged. {}", made_towns, towns, made_industries, industries, old_width, old_height,
+        result == SaveLoadResult::Ok ? "Separate populated save written." : "Save failed; save manually under a new name.");
+    return result == SaveLoadResult::Ok;
+}
