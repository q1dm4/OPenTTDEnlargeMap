+/** Development-only fixture. Runs native construction commands in an empty,
+ * flat single-player map. Refuses games containing any stations or vehicles. */
+static bool ConGatewayDemo(std::span<std::string_view> argv)
+{
+    if (argv.empty()) { IConsolePrint(CC_HELP, "Build the restricted gateway test layout in an empty flat game. Usage: gateway_demo"); return true; }
+    if (argv.size() > 2 || (argv.size() == 2 && argv[1] != "y")) return false;
+    const bool axis_y = argv.size() == 2;
+    const Axis axis = axis_y ? Axis::Y : Axis::X;
+    const Track track = AxisToTrack(axis);
+    auto tile_xy = [axis_y](uint x, uint y) { return axis_y ? TileXY(y, x) : TileXY(x, y); };
+    if (_networking || _game_mode != GameMode::Normal || Station::GetNumItems() != 0 ||
+            Map::SizeX() < 128 || Map::SizeY() < 128) {
+        IConsolePrint(CC_ERROR, "gateway_demo requires an empty flat 128x128 single-player test game. Network {}, mode {}, stations {}, vehicles {}, map {}x{}", _networking, static_cast<uint>(_game_mode), Station::GetNumItems(), Vehicle::GetNumItems(), Map::SizeX(), Map::SizeY()); return true;
+    }
+    for (const Vehicle *vehicle : Vehicle::Iterate()) {
+        if (vehicle->type <= VehicleType::Aircraft) { IConsolePrint(CC_ERROR, "The demo requires a game with no player vehicles."); return true; }
+    }
+    StationClassID gateway_class{}; uint16_t gateway_spec = 0; bool found = false;
+    for (const auto &cls : StationClass::Classes()) for (uint i = 0; i < cls.GetSpecCount(); ++i) {
+        const auto *spec = cls.GetSpec(i);
+        if (spec != nullptr && spec->grf_prop.grfid == TELEPORT_GATEWAY_GRFID && spec->grf_prop.local_id == 0) {
+            gateway_class = cls.Index(); gateway_spec = i; found = true;
+        }
+    }
+    if (!found) { IConsolePrint(CC_ERROR, "Activate the gateway NewGRF before starting this test game."); return true; }
+    // Preflight all terrain before performing any construction.
+    for (uint y : {40U, 90U}) for (uint x = (y == 40 ? 20 : 65); x <= (y == 40 ? 58 : 106); ++x) {
+        TileIndex tile = tile_xy(x, y);
+        if (GetTileSlope(tile) != SLOPE_FLAT ||
+                !(IsTileType(tile, TileType::Clear) || IsTileType(tile, TileType::Trees)) ||
+                TileHeight(tile) != TileHeight(tile_xy(y == 40 ? 20 : 65, y))) {
+            IConsolePrint(CC_ERROR, "Test lane blocked at {},{}: type {}, slope {}, height {}, reference {}", x, y, static_cast<uint>(GetTileType(tile)), static_cast<uint>(GetTileSlope(tile)), TileHeight(tile), TileHeight(tile_xy(20,y))); return true;
+        }
+    }
+    if (!Company::IsValidID(_local_company)) {
+        if (Company::GetNumItems() != 0) { IConsolePrint(CC_ERROR, "Select a local test company."); return true; }
+        DoStartupNewCompany(DSNC_NONE);
+        SetLocalCompany(CompanyID::Begin());
+    }
+    const CompanyID old_company = _current_company;
+    _current_company = _local_company;
+    auto restore_company = scope_guard([&]() { _current_company = old_company; });
+    Company::Get(_current_company)->money = 1000000000; // Empty test game only.
+    _settings_game.vehicle.train_braking_model = TBM_ORIGINAL;
+    auto check = [&](const CommandCost &cost, const char *step) {
+        if (cost.Failed()) IConsolePrint(CC_ERROR, "gateway_demo failed at {}", step);
+        return cost.Succeeded();
+    };
+    const auto flags = DoCommandFlag::Execute;
+    const RailType rt = RAILTYPE_RAIL;
+    for (uint x = 20; x < 58; ++x) if (!check(Command<Commands::BuildRail>::Do(flags, tile_xy(x,40), rt, track, BuildRailTrackFlags::None), "source rail")) return true;
+    for (uint x = 65; x <= 106; ++x) if (!check(Command<Commands::BuildRail>::Do(flags, tile_xy(x,90), rt, track, BuildRailTrackFlags::None), "destination rail")) return true;
+    if (!check(Command<Commands::BuildRailStation>::Do(flags, tile_xy(36,40), rt, axis, 1, 1, gateway_class, gateway_spec, NEW_STATION, true), "gateway A")) return true;
+    if (!check(Command<Commands::BuildRailStation>::Do(flags, tile_xy(90,90), rt, axis, 1, 1, gateway_class, gateway_spec, NEW_STATION, true), "gateway B")) return true;
+    if (!check(Command<Commands::BuildRailStation>::Do(flags, tile_xy(52,40), rt, axis, 1, 4, StationClassID{0}, 0, NEW_STATION, true), "ordinary source station")) return true;
+    if (!check(Command<Commands::BuildRailStation>::Do(flags, tile_xy(70,90), rt, axis, 1, 4, StationClassID{0}, 0, NEW_STATION, true), "ordinary destination station")) return true;
+    TileIndex depot = tile_xy(58,40);
+    if (!check(Command<Commands::BuildRailDepot>::Do(flags, depot, rt, axis_y ? DiagDirection::NW : DiagDirection::NE), "depot")) return true;
+    auto built = Command<Commands::BuildVehicle>::Do(flags, depot, EngineID{0}, false, INVALID_CARGO, CLIENT_ID_SERVER);
+    if (!check(built, "locomotive")) return true;
+    auto id = built.GetResultData<VehicleID>();
+    if (!id.has_value()) { IConsolePrint(CC_ERROR, "No locomotive result ID"); return true; }
+    for (int n = 0; n < 2; ++n) {
+        auto wagon = Command<Commands::BuildVehicle>::Do(flags, depot, EngineID{29}, false, INVALID_CARGO, CLIENT_ID_SERVER);
+        if (!check(wagon, "coal wagon")) return true;
+        auto wagon_id = wagon.GetResultData<VehicleID>();
+        if (!wagon_id.has_value() || !check(Command<Commands::MoveRailVehicle>::Do(flags, *wagon_id, Train::Get(*id)->Last()->index, MoveRailVehicleFlags::None), "attach wagon")) return true;
+        if (n == 0) Train::Get(*wagon_id)->cargo.Append(CargoPacket::Create(static_cast<uint16_t>(7), static_cast<uint16_t>(0), GetStationIndex(tile_xy(52,40)), tile_xy(52,40), Money{0}));
+    }
+    Train::Get(*id)->CargoChanged();
+    for (uint i = 0; i < 2; ++i) {
+        Order order; order.MakeGoToStation(GetStationIndex(i == 0 ? tile_xy(70,90) : tile_xy(52,40)));
+        order.SetNonStopType(ONSF_NO_STOP_AT_INTERMEDIATE_STATIONS);
+        if (!check(DoCommand<Commands::InsertOrder>(InsertOrderCmdData(*id, static_cast<VehicleOrderID>(i), order), flags), "train order")) return true;
+    }
+    if (!check(Command<Commands::StartStopVehicle>::Do(flags, *id, false), "start train")) return true;
+    IConsolePrint(CC_INFO, "Gateway demo built. Train {}: ordinary station -> gateway -> remote ordinary station. Classic braking only.", id->base());
+    return true;
+}
