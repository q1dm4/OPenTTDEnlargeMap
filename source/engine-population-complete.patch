+
+uint GenerateExpansionIndustries(uint count)
+{
+    std::array<uint32_t, NUM_INDUSTRYTYPES> probabilities{};
+    uint32_t total = 0;
+    for (IndustryType type = 0; type < NUM_INDUSTRYTYPES; ++type) {
+        bool forced = false;
+        probabilities[type] = GetScaledIndustryGenerationProbability(type, false, &forced);
+        total += probabilities[type];
+    }
+    if (total == 0) return 0;
+    uint made = 0;
+    for (uint i = 0; i < count; ++i) {
+        uint32_t r = RandomRange(total);
+        IndustryType type = 0;
+        while (r >= probabilities[type]) { r -= probabilities[type]; ++type; }
+        for (uint attempt = 0; attempt < 400; ++attempt) {
+            TileIndex tile = RandomExpansionPopulationTile();
+            if (tile == INVALID_TILE) break;
+            if (CreateNewIndustry(tile, type, IndustryAvailabilityCallType::MapGeneration) != nullptr) { ++made; break; }
+        }
+    }
+    return made;
+}
