+void WriteExpandedMapTiles();
+std::string GetMapExpansionReport();
+
+template <typename T> constexpr uint32_t MapExpansionTileFlag()
+{
+    using U = std::remove_cvref_t<T>;
+    if constexpr (std::is_same_v<U, TileIndex>) return 1U << 12;
+    else if constexpr (std::is_array_v<U>) return MapExpansionTileFlag<std::remove_extent_t<U>>();
+    else if constexpr (requires { typename U::value_type; }) return MapExpansionTileFlag<typename U::value_type>();
+    else return 0;
+}
+#endif
