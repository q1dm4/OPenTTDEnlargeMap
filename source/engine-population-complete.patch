diff --git a/src/teleport_gateway.cpp b/src/teleport_gateway.cpp
new file mode 100644
--- /dev/null
+++ b/src/teleport_gateway.cpp
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "stdafx.h"
+#include "teleport_gateway.h"
+#include "teleport_gateway_policy.h"
+#include "station_base.h"
+#include "newgrf_station.h"
+#include "station_map.h"
+#include "map_func.h"
+#include "train.h"
+#include "newgrf_config.h"
+#include "pathfinder/yapf/yapf_cache.h"
+#include "safeguards.h"
+
+bool IsTeleportGatewayTile(TileIndex tile)
+{
+    if (!IsValidTile(tile) || !IsRailStationTile(tile)) return false;
+    const StationSpec *spec = GetStationSpec(tile);
+    return spec != nullptr && spec->grf_prop.grfid == TELEPORT_GATEWAY_GRFID && spec->grf_prop.local_id == 0;
+}
+
+static TileIndex FindSingleGateway(const Station *station)
+{
+    // Most stations have no gateway spec; avoid scanning their rail areas.
+    bool has_gateway_spec = false;
+    for (const auto &mapping : station->speclist) {
+        if (mapping.grfid == TELEPORT_GATEWAY_GRFID && mapping.spec != nullptr &&
+                mapping.spec->grf_prop.local_id == 0) { has_gateway_spec = true; break; }
+    }
+    if (!has_gateway_spec) return INVALID_TILE;
+    TileIndex result = INVALID_TILE;
+    for (TileIndex tile : station->train_station) {
+        if (!IsTeleportGatewayTile(tile) || GetStationIndex(tile) != station->index) continue;
+        if (result != INVALID_TILE) return INVALID_TILE; // Multiple gateways in one joined station are ambiguous.
+        result = tile;
+    }
+    return result;
+}
+
+void RefreshTeleportGatewayPairs()
+{
+    std::vector<TeleportGateway::Endpoint> endpoints;
+    for (Station *station : Station::Iterate()) {
+        TileIndex anchor = FindSingleGateway(station);
+        if (anchor == INVALID_TILE || anchor != station->teleport_gateway_anchor) {
+            station->teleport_gateway_sequence = 0;
+            station->teleport_gateway_partner = TeleportGateway::UNPAIRED;
+            station->teleport_gateway_partner_sequence = 0;
+        }
+        station->teleport_gateway_anchor = anchor;
+        if (anchor == INVALID_TILE) continue;
+        endpoints.push_back({station->index.base(), station->owner.base(),
+            station->teleport_gateway_sequence, station->teleport_gateway_partner,
+            station->teleport_gateway_partner_sequence});
+    }
+    TeleportGateway::Reconcile(endpoints);
+    bool changed = false;
+    for (const auto &e : endpoints) {
+        Station *station = Station::Get(StationID{e.id});
+        changed |= station->teleport_gateway_partner != e.partner || station->teleport_gateway_sequence != e.sequence;
+        station->teleport_gateway_sequence = e.sequence;
+        station->teleport_gateway_partner = e.partner;
+        station->teleport_gateway_partner_sequence = e.partner_sequence;
+    }
+    if (changed) CSegmentCostCacheBase::NotifyTrackLayoutChange();
+}
+
+TileIndex GetTeleportGatewayPartner(TileIndex tile, Owner owner)
+{
+    if (!IsTeleportGatewayTile(tile)) return INVALID_TILE;
+    const Station *station = Station::GetByTile(tile);
+    if (station->owner != owner || station->teleport_gateway_anchor != tile ||
+            station->teleport_gateway_partner == TeleportGateway::UNPAIRED) return INVALID_TILE;
+    const Station *partner = Station::GetIfValid(StationID{station->teleport_gateway_partner});
+    if (partner == nullptr || partner->owner != owner ||
+            partner->teleport_gateway_partner != station->index.base() ||
+            partner->teleport_gateway_sequence != station->teleport_gateway_partner_sequence ||
+            partner->teleport_gateway_partner_sequence != station->teleport_gateway_sequence ||
+            !IsTeleportGatewayTile(partner->teleport_gateway_anchor) ||
+            GetStationIndex(partner->teleport_gateway_anchor) != partner->index) return INVALID_TILE;
+    return partner->teleport_gateway_anchor;
+}
+
+/** Saves without registered gateways need no custom save feature. */
+bool HasTeleportGatewayState()
+{
+    for (const Station *station : Station::Iterate()) {
+        if (station->teleport_gateway_anchor != INVALID_TILE || station->teleport_gateway_sequence != 0) return true;
+    }
+    return false;
+}
+
+TileIndex GetTeleportGatewayRouteExit(TileIndex tile, DiagDirection direction, Owner owner, const Train *train)
+{
+    if (_settings_game.vehicle.train_braking_model == TBM_REALISTIC) return INVALID_TILE;
+    if (train != nullptr && train->First()->teleport_gateway_exit == tile) return INVALID_TILE;
+    if (!IsTeleportGatewayTile(tile)) return INVALID_TILE;
+    TileIndex partner = GetTeleportGatewayPartner(tile, owner);
+    if (partner == INVALID_TILE || GetRailStationAxis(tile) != GetRailStationAxis(partner) ||
+            DiagDirToAxis(direction) != GetRailStationAxis(tile)) return INVALID_TILE;
+    return TileAddByDiagDir(partner, direction);
+}
+
+bool IsTeleportGatewayRoutingEnabled()
+{
+    // GRF lookup is bounded by the small active-GRF list, unlike scanning all
+    // stations for every search node. It is valid during load as well as ticks.
+    return _settings_game.vehicle.train_braking_model != TBM_REALISTIC && GetGRFConfig(TELEPORT_GATEWAY_GRFID) != nullptr;
+}
