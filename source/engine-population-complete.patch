+static bool ConGatewayStatus(std::span<std::string_view> argv)
+{
+    if (argv.empty()) { IConsolePrint(CC_HELP, "Print train positions and gateway passage counters. Usage: gateway_status"); return true; }
+    if (argv.size() != 1) return false;
+    for (const Train *train : Train::Iterate()) {
+        if (!train->IsFrontEngine()) continue;
+        uint parts = 0, cargo = 0;
+        for (const Train *u = train; u != nullptr; u = u->Next()) { ++parts; cargo += u->cargo.StoredCount(); }
+        IConsolePrint(CC_DEFAULT, "Train {} tile {} passages {} parts {} cargo {} orders {} speed {} exit {}",
+            train->index.base(), train->tile.base(), train->teleport_gateway_passages, parts, cargo,
+            train->GetNumOrders(), train->cur_speed, train->teleport_gateway_exit.base());
+    }
+    return true;
+}
+
+/** Test-only exit obstruction control for the exact demo layout. */
+static bool ConGatewayTestBlock(std::span<std::string_view> argv)
+{
+    if (argv.empty()) { IConsolePrint(CC_HELP, "Obstruct the demo exit. Usage: gateway_test_block on|vehicle|off"); return true; }
+    if (argv.size() != 2) return false;
+    const TileIndex target = TileXY(90,90), depot = TileXY(58,40);
+    if (_networking || _game_mode != GameMode::Normal || Map::SizeX() != 128 || Map::SizeY() != 128 ||
+            Station::GetNumItems() != 4 || !IsTeleportGatewayTile(target) || GetRailStationAxis(target) != Axis::X || !IsRailDepotTile(depot) || !Company::IsValidID(_local_company)) {
+        IConsolePrint(CC_ERROR, "Obstruction controls are restricted to the demo layout."); return true;
+    }
+    const CompanyID old_company = _current_company; _current_company = _local_company;
+    auto restore = scope_guard([&]() { _current_company = old_company; });
+    if (argv[1] == "on") {
+        if (!TryReserveRailTrack(target, TRACK_X)) { IConsolePrint(CC_ERROR, "Demo exit is already reserved."); return true; }
+        IConsolePrint(CC_INFO, "Demo gateway exit reserved for obstruction test.");
+    } else if (argv[1] == "vehicle") {
+        auto built = Command<Commands::BuildVehicle>::Do(DoCommandFlag::Execute, depot, EngineID{0}, false, INVALID_CARGO, CLIENT_ID_SERVER);
+        auto id = built.GetResultData<VehicleID>();
+        if (built.Failed() || !id.has_value()) { IConsolePrint(CC_ERROR, "Could not create the stopped obstruction train."); return true; }
+        Train *train = Train::Get(*id);
+        train->tile = target; train->track = TRACK_BIT_X;
+        train->x_pos = TileX(target) * TILE_SIZE + 8; train->y_pos = TileY(target) * TILE_SIZE + 8;
+        train->z_pos = GetSlopePixelZ(train->x_pos, train->y_pos, true);
+        train->SetMovingDirection(Direction::NE); train->vehstatus.Reset(VehState::Hidden);
+        train->UpdatePosition(); train->UpdateInclination(true, false, false);
+        train->ConsistChanged(CCF_TRACK); train->MarkDirty();
+        TryReserveRailTrack(target, TRACK_X);
+        IConsolePrint(CC_INFO, "Stopped obstruction train {} placed on the demo gateway exit.", id->base());
+    } else if (argv[1] == "off") {
+        for (Train *train : Train::Iterate()) {
+            if (!train->IsFrontEngine() || train->tile != target || !train->vehstatus.Test(VehState::Stopped) || train->Next() != nullptr) continue;
+            const VehicleID id = train->index;
+            train->tile = depot; train->track = TRACK_BIT_DEPOT;
+            train->x_pos = TileX(depot) * TILE_SIZE + 8; train->y_pos = TileY(depot) * TILE_SIZE + 8;
+            train->z_pos = GetSlopePixelZ(train->x_pos, train->y_pos, true); train->vehstatus.Set(VehState::Hidden);
+            train->UpdatePosition(); train->UpdateInclination(true, false, false);
+            auto result = Command<Commands::SellVehicle>::Do(DoCommandFlag::Execute, depot, id, SellVehicleFlags::SellChain, CLIENT_ID_SERVER);
+            if (result.Failed()) { IConsolePrint(CC_ERROR, "Could not remove the test obstruction train."); return true; }
+            break;
+        }
+        UnreserveRailTrack(target, TRACK_X);
+        IConsolePrint(CC_INFO, "Demo gateway exit obstruction removed.");
+    } else return false;
+    UpdateSignalsOnSegment(target, DiagDirection::NE, _current_company);
+    UpdateSignalsOnSegment(target, DiagDirection::SW, _current_company);
+    return true;
+}
